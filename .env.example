# PrepVerse AI Environment Configuration

# Application
APP_NAME=PrepVerse AI
APP_ENV=development
SECRET_KEY=prepverse_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite for zero-config local run, replace with PostgreSQL URL for production)
DATABASE_URL=sqlite:///./prepverse.db
# DATABASE_URL=postgresql://user:password@localhost:5432/prepverse_db

# Redis Cache (Optional for dev)
REDIS_URL=redis://localhost:6379/0

# External AI Credentials (Optional: Falls back to built-in MockAIService if blank)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Code Execution (Judge0) credentials (Optional: Falls back to built-in MockJudgeService)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# Payment Credentials (Optional: Falls back to MockPaymentService)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
